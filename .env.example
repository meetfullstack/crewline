# Copy to apps/api/.env and apps/web/.env.local (see README)

# --- API (apps/api/.env) ---
PORT=4000
DATABASE_URL=postgresql://crewline:crewline@localhost:5432/crewline
# Optional: without it, background jobs run in-process and shift reminders are off.
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
WEB_ORIGIN=http://localhost:3300

# --- Web (apps/web/.env.local) ---
# Where the Next.js server proxies /api/* (server-side only).
API_URL=http://localhost:4000
# Where the browser opens the realtime socket (the API's public URL).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
